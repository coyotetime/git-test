{
  "expo": {
    "name": "Scenic",
    "slug": "scenic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scenic",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scenic.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F0",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.scenic.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F0"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scenic uses your location to start scenic drives near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
